{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kino-quotation-pdf",
  "main": "src/index.js",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://aaronkino.github.io"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0
  }
}
